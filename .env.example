# --- Authentification ---
# Clé secrète (sessions, liens de réinitialisation) : longue chaîne aléatoire, obligatoire en production
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Base des comptes : fournie par l'addon PostgreSQL sur Scalingo ; vide en local = SQLite (instance/pony_express.db)
# DATABASE_URL=
# HTTP local sans --debug : mettre 0 (sinon le cookie de session n'est envoyé qu'en HTTPS)
# SESSION_COOKIE_SECURE=0

# --- E-mails (mot de passe oublié) ---
# Sans SMTP_HOST, l'e-mail n'est pas envoyé : le lien est écrit dans les logs
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TLS=starttls   # ou ssl, ou non
