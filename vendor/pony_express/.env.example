# Copier ce fichier en .env et remplir les valeurs (le .env n'est jamais versionné)

# Grist
GRIST_SERVER=https://grist.numerique.gouv.fr
GRIST_TEAM_SITE=docs
GRIST_DOC_ID=identifiant_du_document
GRIST_API_KEY=cle_api_personnelle
# table principale des mobilités individuelles (démarche 128447)
GRIST_TABLE=Demarche_128447_annotations
# facultatif : table principale des mobilités de groupe (par défaut Demarche_156967_champs)
# GRIST_TABLE_GROUPE=Demarche_156967_champs
